{
  "name": "sw-agent-workbench",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"bun run dev:server\" \"vite\"",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test tests/unit/",
    "test:e2e": "bunx playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock-runtime": "^3.692.0",
    "hono": "^4.7.0",
    "ollama": "^0.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
