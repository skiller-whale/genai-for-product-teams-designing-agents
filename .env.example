# AI provider: 'bedrock' (hosted environment), 'claude', or 'ollama' (local dev)
AI_PROVIDER=claude

# Required when AI_PROVIDER=bedrock (the Skiller Whale hosted environment sets
# this automatically — it is the learner's attendance id, used as the AWS key).
# SW_ATTENDANCE_ID=
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# Required when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Where learner config + eval run history are stored (defaults to ./data)
# DATA_DIR=./data
